APP_NAME="DzakaAl - Portofolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# URL absolut untuk file storage (dipakai Storage::url agar bisa diakses frontend lintas domain)
ASSET_URL="${APP_URL}"

# Origin frontend yang diizinkan mengakses API (config/cors.php), pisahkan dengan koma
CORS_ALLOWED_ORIGINS=http://localhost:3000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
